# ==== Copiar a .env (make demo lo hace si no existe). NUNCA comitear .env ====

# Proyecto y entorno
COMPOSE_PROJECT_NAME=unidades-demo
# demo: habilita la semilla de usuarios/unidades ficticios y las contraseñas de demo.
# produccion: la semilla se niega; los usuarios con es_demo=true no pueden ingresar.
ENTORNO=demo

# Postgres (servicio db)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=demo_unidades
DEMO_DB_OWNER=demo_migraciones
DEMO_DB_OWNER_PASSWORD=cambiar_owner_migraciones
DEMO_DB_APP_USER=demo_app
DEMO_DB_APP_PASSWORD=cambiar_app_api

# Conexiones de la API (host interno del contenedor)
DATABASE_URL=postgresql+psycopg://demo_app:cambiar_app_api@db:5432/demo_unidades
DATABASE_URL_MIGRACIONES=postgresql+psycopg://demo_migraciones:cambiar_owner_migraciones@db:5432/demo_unidades

# Seguridad
JWT_SECRET=cambiar_clave_jwt_larga_y_aleatoria
JWT_ALGORITMO=HS256
DURACION_TOKEN_HORAS=8
SESION_INACTIVA_MINUTOS=30
INTENTOS_MAXIMOS=5
BLOQUEO_MINUTOS=15
VALIDEZ_CLAVE_TEMPORAL_HORAS=48

# Semilla de usuarios de demo (contraseñas documentadas en README)
DEMO_PASSWORD_ADMIN=DemoAdmin2026!
DEMO_PASSWORD_MARKETING=DemoMkt2026!
DEMO_PASSWORD_ASESOR=DemoAsesor2026!
DEMO_PASSWORD_POSVENTA=DemoPosventa2026!
DEMO_PASSWORD_TALLER=DemoTaller2026!
DEMO_PASSWORD_USADOS=DemoUsados2026!

# Adaptadores externos
DMS_API_URL=http://dms:8100
TRACCAR_API_URL=http://traccar:8082
TRACCAR_API_KEY=demo-traccar-key
N8N_API_KEY=cambiar_api_key_n8n

# Correo de prueba (GreenMail)
SMTP_HOST=mail
SMTP_PORT=3025

# Programación
SYNC_DMS_CADA_MINUTOS=1
TIMEZONE_DISPLAY=America/Argentina/Buenos_Aires

# Frontend
API_BASE_URL=http://api:8000/api/v1

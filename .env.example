# Copiar a .env (make demo lo hace si no existe) y cambiar los valores "cambiar_...".
# Datos ficticios de demostracion (Ley 25.326). Nunca versionar el .env real.

COMPOSE_PROJECT_NAME=unidades-demo
# demo: habilita la semilla y las cuentas de demo; produccion: las bloquea (valor por defecto).
ENTORNO=demo

# --- Base de datos: rol dueño (migraciones) y rol de aplicacion (API) ---
POSTGRES_DB=demo_unidades
DEMO_DB_OWNER=demo_migraciones
DEMO_DB_OWNER_PASSWORD=cambiar_clave_migraciones
DEMO_DB_APP_USER=demo_app
DEMO_DB_APP_PASSWORD=cambiar_clave_app
TEST_DB_NAME=demo_unidades_test

# --- Seguridad de la API ---
JWT_SECRET=cambiar_secreto_jwt_largo_y_aleatorio
N8N_API_KEY=cambiar_api_key_n8n

# --- n8n (http://localhost:5678) ---
N8N_CLAVE_ADMIN=demo-n8n

# --- Claves de los usuarios de demo (scripts/seed.py, solo con ENTORNO=demo) ---
# Opcionales: si faltan, la semilla usa las claves del README. Las cuentas quedan con
# es_demo=true: no exigen cambio de clave en el primer ingreso y no ingresan en produccion.
DEMO_CLAVE_ADMIN=DemoAdmin2026!
DEMO_CLAVE_MARKETING=DemoMkt2026!
DEMO_CLAVE_ASESOR=DemoAsesor2026!
DEMO_CLAVE_POSVENTA=DemoPosventa2026!
DEMO_CLAVE_TALLER=DemoTaller2026!
DEMO_CLAVE_USADOS=DemoUsados2026!

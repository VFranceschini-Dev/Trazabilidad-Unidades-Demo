FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /srv

# Tesseract y poppler para probar el lector de actas de n8n (n8n/lector_actas.py)
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-spa poppler-utils && rm -rf /var/lib/apt/lists/*

# Imagen solo para el servicio "test" (perfil test): instala las dependencias de
# produccion mas las de prueba. La imagen de produccion (backend/Dockerfile) no las lleva.
COPY backend/requirements.txt /srv/backend/requirements.txt
COPY backend/requirements-dev.txt /srv/backend/requirements-dev.txt
RUN pip install --no-cache-dir -r /srv/backend/requirements.txt -r /srv/backend/requirements-dev.txt

CMD ["python", "-m", "pytest", "-q"]

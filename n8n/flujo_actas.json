[
  {
    "id": "flujoactasdemo01",
    "name": "Lectura de actas de infraccion",
    "active": false,
    "settings": {},
    "connections": {
      "Correo de actas": {
        "main": [
          [
            {
              "node": "Tiene PDF adjunto",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Tiene PDF adjunto": {
        "main": [
          [
            {
              "node": "Guardar PDF",
              "type": "main",
              "index": 0
            }
          ],
          []
        ]
      },
      "Guardar PDF": {
        "main": [
          [
            {
              "node": "Leer acta con Tesseract",
              "type": "main",
              "index": 0
            }
          ]
        ]
      },
      "Leer acta con Tesseract": {
        "main": [
          [
            {
              "node": "Enviar a la API",
              "type": "main",
              "index": 0
            }
          ]
        ]
      }
    },
    "nodes": [
      {
        "id": "a1a1a1a1-0000-4000-8000-000000000001",
        "name": "Correo de actas",
        "type": "n8n-nodes-base.emailReadImap",
        "typeVersion": 2,
        "position": [
          240,
          300
        ],
        "credentials": {
          "imap": {
            "id": "imapactasdemo001",
            "name": "Casilla de actas (GreenMail)"
          }
        },
        "parameters": {
          "mailbox": "INBOX",
          "postProcessAction": "read",
          "format": "resolved",
          "options": {
            "allowUnauthorizedCerts": true
          }
        }
      },
      {
        "id": "a1a1a1a1-0000-4000-8000-000000000002",
        "name": "Tiene PDF adjunto",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [
          480,
          300
        ],
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": false,
              "leftValue": "",
              "typeValidation": "loose"
            },
            "combinator": "and",
            "conditions": [
              {
                "id": "c1c1c1c1-0000-4000-8000-000000000001",
                "leftValue": "={{ $binary.attachment_0?.fileName ?? '' }}",
                "rightValue": ".pdf",
                "operator": {
                  "type": "string",
                  "operation": "endsWith"
                }
              }
            ]
          },
          "options": {}
        }
      },
      {
        "id": "a1a1a1a1-0000-4000-8000-000000000004",
        "name": "Guardar PDF",
        "type": "n8n-nodes-base.readWriteFile",
        "typeVersion": 1,
        "position": [
          720,
          240
        ],
        "parameters": {
          "operation": "write",
          "fileName": "=/actas/acta-{{ $execution.id }}-{{ $itemIndex }}.pdf",
          "dataPropertyName": "attachment_0",
          "options": {}
        }
      },
      {
        "id": "a1a1a1a1-0000-4000-8000-000000000005",
        "name": "Leer acta con Tesseract",
        "type": "n8n-nodes-base.executeCommand",
        "typeVersion": 1,
        "position": [
          960,
          240
        ],
        "parameters": {
          "command": "=/opt/ocr/bin/python /flujos/lector_actas.py /actas/acta-{{ $execution.id }}-{{ $itemIndex }}.pdf",
          "executeOnce": false
        }
      },
      {
        "id": "a1a1a1a1-0000-4000-8000-000000000003",
        "name": "Enviar a la API",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1200,
          240
        ],
        "retryOnFail": true,
        "maxTries": 3,
        "waitBetweenTries": 5000,
        "parameters": {
          "method": "POST",
          "url": "http://api:8000/api/v1/infracciones/ingesta",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "X-API-Key",
                "value": "={{ $env.N8N_API_KEY }}"
              }
            ]
          },
          "sendBody": true,
          "contentType": "json",
          "specifyBody": "json",
          "jsonBody": "={{ Object.assign(JSON.parse($json.stdout), { archivo_pdf: 'acta-' + $execution.id + '-' + $itemIndex + '.pdf' }) }}",
          "options": {}
        }
      }
    ]
  }
]
